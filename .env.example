# Copy to .env at the repository root (never committed). Read by Compose and, in
# development, by the backend.
# Absolute path of this repository on the machine that runs the experiment: data/ and
# genome/ live here and are mounted at the same path inside the containers.
DARWIN_HOME=/absolute/path/to/darwin-chess
# Model provider: anthropic (default) or openrouter. The model defaults to Haiku 5.5 under
# that provider's id; DARWIN_LLM_MODEL overrides it.
DARWIN_LLM_PROVIDER=anthropic
# Key of that provider, handed to pi. With anthropic it also writes the site commentary.
DARWIN_LLM_API_KEY=
# Daily ceiling for the site commentary, separate from the agent's budget.
DARWIN_COMMENTARY_DAILY_USD=0.20
# Lichess bot (account converted to BOT).
DARWIN_LICHESS_ENABLED=false
DARWIN_LICHESS_TOKEN=
